__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/
*.egg-info/

# Real price data is not committed -- each collaborator pulls their own
# copy into data/raw/ per README.md; only the synthetic-data smoke-test
# outputs (checked in deliberately as evidence of temporary results) are
# tracked.
data/raw/*
!data/raw/.gitkeep

# Long-history proxy data, pulled by scripts/experiments/fetch_proxy_data.py;
# provenance and hashes are tracked in outputs/experiments/proxy_data_manifest.json.
data/proxy/*
